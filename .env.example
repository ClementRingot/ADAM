# abap-debugger-mcp — copy to .env (never commit it) and pass it with: --env-file /path/to/.env
# Every setting is described in docs/configuration.md.

# On-premise system (Basic authentication)
SAP_URL=https://my-sap-host:44300
SAP_CLIENT=100
SAP_LANGUAGE=EN
SAP_USER=DEVELOPER
SAP_PASSWORD=change-me

# …or cookies instead of a password (Netscape cookie file, or inline name=value pairs)
# SAP_COOKIE_FILE=/path/to/cookies.txt
# SAP_COOKIE_STRING=MYSAPSSO2=...

# …or the SAP BTP ABAP Environment: a service key file (browser login on first use)
# SAP_BTP_SERVICE_KEY_FILE=/path/to/abap-service-key.json
# SAP_BTP_OAUTH_CALLBACK_PORT=0

# Optional
# SAP_PROXY=http://proxy.example:8080
# SAP_INSECURE=false
# SAP_DISABLE_SAML=false
# SAP_ABAP_RELEASE=758
# ABAP_DEBUGGER_LOG_LEVEL=info

# Debugging bounds
# ABAP_DEBUGGER_MAX_SECONDS=600
# ABAP_DEBUGGER_MAX_RESULT_KB=200
# ABAP_DEBUGGER_IDLE_SECONDS=120
# ABAP_DEBUGGER_SESSION_SECONDS=900
