{
  "name": "@adam-mcp/server",
  "version": "1.0.1",
  "description": "MCP server that debugs ABAP code in SAP's debugger for AI assistants: one-shot captures and interactive sessions, over stdio or HTTP (SAP BTP Cloud Foundry).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "abap-debugger-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts/prepare.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClementRingot/ADAM.git"
  },
  "homepage": "https://github.com/ClementRingot/ADAM#readme",
  "bugs": {
    "url": "https://github.com/ClementRingot/ADAM/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sap",
    "abap",
    "adt",
    "debugger"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:exe": "npm run build && node scripts/build-exe.mjs",
    "typecheck": "tsc -p tsconfig.tests.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "node scripts/prepare.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-version.mjs && npm install --package-lock-only",
    "changeset:check": "node scripts/require-changeset.mjs"
  },
  "dependencies": {
    "@abaplint/core": "^2.120.86",
    "@arc-mcp/xsuaa-auth": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
